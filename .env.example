# Configuración del Proveedor de IA
# Opciones para LLM_PROVIDER: 'gemini' | 'openrouter' | 'groq'
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=
# max_tokens recomendado para cuentas gratuitas de OpenRouter (evita el error 402)
LLM_MAX_TOKENS=1500

# Opcional (si usas Gemini nativo podés poner la key acá o en LLM_API_KEY)
GEMINI_API_KEY=

# Opcional: Configuración específica para desacoplar el proveedor de transcripción de audio (ej: usar Deepgram con Nova-2)
# Opciones para TRANSCRIPTION_PROVIDER: 'deepgram' | 'gemini' | 'groq' | 'openrouter'
# TRANSCRIPTION_PROVIDER=deepgram
# TRANSCRIPTION_API_KEY=tu_clave_de_deepgram

# Opcional: Endpoint genérico de Whisper (solo si TRANSCRIPTION_PROVIDER es groq/openrouter/openai)
# LLM_AUDIO_URL=https://api.groq.com/openai/v1/audio/transcriptions
# LLM_AUDIO_MODEL=whisper-large-v3

# Configuración de Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
